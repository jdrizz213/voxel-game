import * as THREE from "https://unpkg.com/three@0.160.0/build/three.module.js";

// === SCENE ===
const scene = new THREE.Scene();
scene.background = new THREE.Color(0x87ceeb);

// === CAMERA ===
const camera = new THREE.PerspectiveCamera(
    75,
    window.innerWidth / window.innerHeight,
    0.1,
    1000
);
camera.position.set(10, 8, 20);

// === RENDERER ===
const renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setSize(window.innerWidth, window.innerHeight);
document.body.appendChild(renderer.domElement);

// === LIGHT ===
const sun = new THREE.DirectionalLight(0xffffff, 1);
sun.position.set(20, 40, 20);
scene.add(sun);

// === MATERIALS ===
const materials = {
    grass: new THREE.MeshStandardMaterial({ color: 0x3ba635 }),
    sand: new THREE.MeshStandardMaterial({ color: 0xd9c27a }),
    snow: new THREE.MeshStandardMaterial({ color: 0xffffff }),
    stone: new THREE.MeshStandardMaterial({ color: 0x888888 }),
    crystal: new THREE.MeshStandardMaterial({ color: 0x66ccff, emissive: 0x2288ff, emissiveIntensity: 0.4 })
};

// === WORLD ===
const blockSize = 1;
const worldSize = 32;
const geometry = new THREE.BoxGeometry(blockSize, blockSize, blockSize);
const blocks = [];

function addBlock(x, y, z, type) {
    const block = new THREE.Mesh(geometry, materials[type]);
    block.position.set(x, y, z);
    block.userData.type = type;
    scene.add(block);
    blocks.push(block);
}

// More biomes: grass, sand, snow, stone patches
function getBiome(x, z) {
    const n1 = Math.sin(x * 0.2) + Math.cos(z * 0.2);
    const n2 = Math.sin(x * 0.05) * Math.cos(z * 0.05);
    const v = n1 * 0.5 + n2;

    if (v > 1) return "snow";      // cold peaks
    if (v > 0.3) return "stone";   // rocky
    if (v < -0.5) return "sand";   // desert
    return "grass";                // default
}

// Generate world
function generateWorld() {
    for (let x = 0; x < worldSize; x++) {
        for (let z = 0; z < worldSize; z++) {
            const biome = getBiome(x, z);
            addBlock(x, 0, z, biome);
        }
    }
}

generateWorld();

// === SAVE/LOAD ===
function saveWorld() {
    const data = blocks.map(b => ({
        x: b.position.x,
        y: b.position.y,
        z: b.position.z,
        type: b.userData.type
    }));
    localStorage.setItem("voxelWorld", JSON.stringify(data));
}

function loadWorld() {
    const data = JSON.parse(localStorage.getItem("voxelWorld"));
    if (!data) return;

    blocks.forEach(b => scene.remove(b));
    blocks.length = 0;

    data.forEach(b => addBlock(b.x, b.y, b.z, b.type));
}

loadWorld();
setInterval(saveWorld, 5000);

// === INVENTORY ===
let selectedBlock = "grass";
document.querySelectorAll(".slot").forEach(slot => {
    slot.addEventListener("click", () => {
        document.querySelectorAll(".slot").forEach(s => s.classList.remove("selected"));
        slot.classList.add("selected");
        selectedBlock = slot.dataset.block;
    });
});

// === SIMPLE CRAFTING ===
// Rule: 3 stone blocks in the world → 1 crystal block added at player feet
const craftButton = document.getElementById("craft-crystal");
const craftInfo = document.getElementById("craft-info");

function countBlocksOfType(type) {
    return blocks.filter(b => b.userData.type === type).length;
}

craftButton.addEventListener("click", () => {
    const stoneCount = countBlocksOfType("stone");
    if (stoneCount < 3) {
        craftInfo.textContent = `Need 3 Stone. You have ${stoneCount}.`;
        return;
    }

    // "Consume" 3 stone blocks (remove first 3)
    let removed = 0;
    for (let i = blocks.length - 1; i >= 0 && removed < 3; i--) {
        if (blocks[i].userData.type === "stone") {
            scene.remove(blocks[i]);
            blocks.splice(i, 1);
            removed++;
        }
    }

    // Place a crystal block near the player
    const px = Math.round(camera.position.x);
    const pz = Math.round(camera.position.z);
    addBlock(px, 1, pz, "crystal");

    craftInfo.textContent = "Crafted a Crystal!";
    setTimeout(() => (craftInfo.textContent = ""), 2000);
});

// === PLAYER MOVEMENT ===
let keys = {};
document.addEventListener("keydown", e => keys[e.key] = true);
document.addEventListener("keyup", e => keys[e.key] = false);

let yaw = 0;
let pitch = 0;
let dragging = false;
let prevX = 0;
let prevY = 0;

window.addEventListener("mousedown", e => {
    dragging = true;
    prevX = e.clientX;
    prevY = e.clientY;
});
window.addEventListener("mouseup", () => dragging = false);

window.addEventListener("mousemove", e => {
    if (!dragging) return;
    const dx = e.clientX - prevX;
    const dy = e.clientY - prevY;
    prevX = e.clientX;
    prevY = e.clientY;

    yaw -= dx * 0.002;
    pitch -= dy * 0.002;
    pitch = Math.max(-1.2, Math.min(1.2, pitch));
});

// === RAYCASTING ===
const raycaster = new THREE.Raycaster();

function getHit() {
    raycaster.setFromCamera(new THREE.Vector2(0, 0), camera);
    const hits = raycaster.intersectObjects(blocks);
    return hits.length ? hits[0] : null;
}

// Break block
window.addEventListener("click", e => {
    const hit = getHit();
    if (!hit) return;

    scene.remove(hit.object);
    blocks.splice(blocks.indexOf(hit.object), 1);
});

// Place block
window.addEventListener("contextmenu", e => {
    e.preventDefault();
    const hit = getHit();
    if (!hit) return;

    const pos = hit.object.position.clone();
    const normal = hit.face.normal.clone();
    const placePos = pos.add(normal);

    addBlock(placePos.x, placePos.y, placePos.z, selectedBlock);
});

// === DAY/NIGHT CYCLE ===
let time = 0;

function updateDayNight() {
    time += 0.002;
    const brightness = (Math.sin(time) + 1) / 2;
    sun.intensity = 0.2 + brightness * 0.8;
    scene.background = new THREE.Color().setHSL(0.6, 0.6, 0.4 + brightness * 0.4);
}

// === ANIMATION LOOP ===
function animate() {
    requestAnimationFrame(animate);

    updateDayNight();

    camera.rotation.order = "YXZ";
    camera.rotation.y = yaw;
    camera.rotation.x = pitch;

    const speed = 0.15;
    const forward = new THREE.Vector3(Math.sin(yaw), 0, Math.cos(yaw));
    const right = new THREE.Vector3(Math.cos(yaw), 0, -Math.sin(yaw));

    if (keys["w"]) camera.position.addScaledVector(forward, -speed);
    if (keys["s"]) camera.position.addScaledVector(forward, speed);
    if (keys["a"]) camera.position.addScaledVector(right, -speed);
    if (keys["d"]) camera.position.addScaledVector(right, speed);

    renderer.render(scene, camera);
}

animate();

// === RESIZE ===
window.addEventListener("resize", () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
});
